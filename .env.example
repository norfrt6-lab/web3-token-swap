# RPC endpoint for Sepolia testnet (get from Alchemy or Infura)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Chain ID for Sepolia
NEXT_PUBLIC_CHAIN_ID=11155111

# Optional: WalletConnect Project ID (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-side RPC URL (used by API routes — never exposed to client)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
